/*
    This file is manly for accessing registers and setting them. So it is nicely split with other modules and in the end added with the other files
*/

module Registers_Module {
    callee mem: Memory_Module_Interface;

    // Just a bool for knowing the state
    instance smm_active: State<Bool>(false);
    // instance operand_size_16_32: State<Bool>(false);
    instance Code_Selector: State<Register16>(any); // for jump and calls for segment

    // General Purpose Registers
