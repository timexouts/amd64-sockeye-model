    /*
        Register initialization 
    */
    mut fn init_processor_state_reset(){ // Value After RESET
        CR0.set(0x0000_0000_6000_0010);
        CR2.set(0);
        CR3.set(0);
        CR4.set(0);
        CR8.set(0);
        
        RFLAGS.set(2);
        EFER.set(0);
        RIP.set(0x0000_0000_0000_FF00);
        
        CS_Selector.set(0xF000);
        CS_Limit.set(0xFFFF_u32);
        CS_Base.set(0x0000_0000_FFFF_0000);
        
        DS_Selector.set(0x0000);
        DS_Limit.set(0xFFFF_u32);
        DS_Base.set(0);
        
        ES_Selector.set(0x0000);
        ES_Limit.set(0xFFFF_u32);
        ES_Base.set(0);
        
        FS_Selector.set(0x0000);
        FS_Limit.set(0xFFFF_u32);
        FS_Base.set(0);
        
        GS_Selector.set(0x0000);
        GS_Limit.set(0xFFFF_u32);
        GS_Base.set(0);
        
        SS_Selector.set(0x0000);
        SS_Limit.set(0xFFFF_u32);
        SS_Base.set(0);
        
        GDTR_Limit.set(0xFFFF);
        GDTR_Base.set(0);
        
        IDTR_Limit.set(0xFFFF);
        IDTR_Base.set(0);
        
        LDTR_Selector.set(0);
        LDTR_Limit.set(0xFFFF_u32);
        LDTR_Base.set(0);
        
        TR_Selector.set(0);
        TR_Limit.set(0xFFFF_u32);
        TR_Base.set(0);
        
        RAX.set(0);
        RDX.set(0);
        
        RBX.set(0);
        RCX.set(0);
        RBP.set(0);
        RSP.set(0);
        RDI.set(0);
        RSI.set(0);
        R8.set(0);
        R9.set(0);
        R10.set(0);
        R11.set(0);
        R12.set(0);
        R13.set(0);
        R14.set(0);
        R15.set(0);
        
        DR0.set(0);
        DR1.set(0);
        DR2.set(0);
        DR3.set(0);
        
        DR6.set(0x0000_0000_FFFF_0FF0);
        DR7.set(0x0000_0000_0000_0400);
        
       
    }  
    mut fn init_processor_state_init(){ // Value After INIT
        CR0.set((CR0.get() & 0x0000_0000_C000_0000) | 0x0000_0000_0000_0004); // keep Cache Disabled, Not Writethrough and set bit 4 to 1
        CR2.set(0);
        CR3.set(0);
        CR4.set(0);
        CR8.set(0); 
        RFLAGS.set(2);
        EFER.set(0);
        RIP.set(0x0000_0000_0000_FF00); 

        CS_Selector.set(0xF000);
        CS_Limit.set(0xFFFF_u32);
        CS_Base.set(0x0000_0000_FFFF_0000); 

        DS_Selector.set(0x0000);
        DS_Limit.set(0xFFFF_u32);
        DS_Base.set(0); 

        ES_Selector.set(0x0000);
        ES_Limit.set(0xFFFF_u32);
        ES_Base.set(0);
        
        FS_Selector.set(0x0000);
        FS_Limit.set(0xFFFF_u32);
        FS_Base.set(0); 
        GS_Selector.set(0x0000);
        GS_Limit.set(0xFFFF_u32);
        GS_Base.set(0);
        
        SS_Selector.set(0x0000);
        SS_Limit.set(0xFFFF_u32);
        SS_Base.set(0);

        GDTR_Limit.set(0xFFFF);
        GDTR_Base.set(0);   

        IDTR_Limit.set(0xFFFF);
        IDTR_Base.set(0);

        LDTR_Selector.set(0);
        LDTR_Limit.set(0xFFFF_u32);
        LDTR_Base.set(0);

        TR_Selector.set(0);
        TR_Limit.set(0xFFFF_u32);
        TR_Base.set(0);
        
        RAX.set(0);
        RDX.set(0); 
        RBX.set(0);
        RCX.set(0);
        RBP.set(0);
        RSP.set(0);
        RDI.set(0);
        RSI.set(0);
        R8.set(0);
        R9.set(0);
        R10.set(0);
        R11.set(0);
        R12.set(0);
        R13.set(0);
        R14.set(0);
        R15.set(0); 
        DR0.set(0);
        DR1.set(0);
        DR2.set(0);
        DR3.set(0); 
        DR6.set(0x0000_0000_FFFF_0FF0);
        DR7.set(0x0000_0000_0000_0400); 
       
    }
    mut fn init_smm_register(){
        SMBASE.set(0x0003_0000_u32); // Default value
        SMM_ADDR.set(0x0002_0000_u64); // min address for the SMBASE
        SMM_MASK.set(0xFFFF_FFFF_FFFE_0002); // 128KB segment, min
       
    }
    mut fn init_system_register_longmode(LA57: BitInt(1)){
        //        Res      PG                                PE
        let cr0 = 0_u32 ## 1_u1 ## CR0.get()[30 downto 1] ## 1_u1;
        CR0.set(cr0);
        //        Res                                 LA57                              PAE
        let cr4 = 0_u40 ## CR4.get()[23 downto 13] ## LA57 ## CR4.get()[11 downto 6] ## 1_u1 ## CR4.get()[4 downto 0];
        CR4.set(cr4);
        //         Res                                  LMA     Res     LME
        let efer = 0_u42 ## EFER.get()[21 downto 11] ## 1_u1 ## 0_u1 ## 1_u1 ## EFER.get()[7 downto 0];
        EFER.set(efer);
       
    }
    /*
        Register functions
    */
    mut fn load_gdtr(address: QuadWord){
        let lma = EFER.get()[10]; // In long mode

        if(lma){ // Long mode
            let limit = mem.read_va(address + 1, E_DS) ## mem.read_va(address, E_DS);

            let gdt_address: BitInt(64) = mem.read_va(address + 9, E_DS) ## mem.read_va(address + 8, E_DS) 
                                        ## mem.read_va(address + 7, E_DS) ## mem.read_va(address + 6, E_DS)
                                        ## mem.read_va(address + 5, E_DS) ## mem.read_va(address + 4, E_DS)
                                        ## mem.read_va(address + 5, E_DS) ## mem.read_va(address + 4, E_DS);

            GDTR_Limit.set(limit);
            GDTR_Base.set(gdt_address);
        }
        else if(smm_active.get()){ // huge real mode, unreal mode
            let limit = mem.read_phy(0_u20 ## (address + 1)[31 downto 0]) ## mem.read_phy(0_u20 ## (address)[31 downto 0]);
            let gdt_address: BitInt(64) = 0_u32 ## mem.read_phy(0_u20 ## (address + 5)[31 downto 0]) ## mem.read_phy(0_u20 ## (address + 4)[31 downto 0])
                                                ## mem.read_phy(0_u20 ## (address + 3)[31 downto 0]) ## mem.read_phy(0_u20 ## (address + 2)[31 downto 0]);

            GDTR_Limit.set(limit);
            GDTR_Base.set(gdt_address);
        }
        else { // Realmode, protected mode
            let limit = mem.read_va(address + 1, E_DS) ## mem.read_va(address, E_DS);
            let gdt_address: BitInt(64) = 0_u32 ## mem.read_va(address + 5, E_DS) ## mem.read_va(address + 4, E_DS)
                                                ## mem.read_va(address + 3, E_DS) ## mem.read_va(address + 2, E_DS);

            GDTR_Limit.set(limit);
            GDTR_Base.set(gdt_address);
        };
       
    }

    mut fn set_tclose(value: BitInt(1)){
        let smm_mask = SMM_MASK.get();
        SMM_MASK.set(smm_mask[63 downto 4] ## value ## smm_mask[2 downto 0]);
       
    }
    /*
        Register initalzisation to switch addressing mode
    */

    /*
        Ring 3 (Usermode) Register operation
    */
    mut fn usermode_register(){
        RAX.set(any);
        RBX.set(any);
        RCX.set(any);
        RDX.set(any);
        RBP.set(any);
        RDI.set(any);
        RSI.set(any);
        RSP.set(any);
        R8.set(any);
        R9.set(any);
        R10.set(any);
        R11.set(any);
        R12.set(any);
        R13.set(any);
        R14.set(any);
        R15.set(any);

        let flags = RFLAGS.get();
        RFLAGS.set(flags[63 downto 12] ## any<BitInt(2)> ## flags[9 downto 8] ## any<BitInt(2)> ## flags[5 downto 5] ## any<BitInt(1)> ## flags[3 downto 3] ## any<BitInt(1)> ## flags[1 downto 1] ## any<BitInt(1)>); // set the flags to any
       
    }
